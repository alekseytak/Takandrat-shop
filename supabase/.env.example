
# --- SUPABASE EDGE FUNCTIONS ---
# Эти переменные обычно задаются через CLI: supabase secrets set KEY=VALUE
# Или в Dashboard Supabase. Этот файл просто для справки.
# НИКОГДА не пишите сюда реальные значения.

# Токен бота из BotFather
TELEGRAM_BOT_TOKEN=

# Секрет для верификации вебхука от Telegram (задайте в BotFather / setWebhook)
TELEGRAM_WEBHOOK_SECRET=

# ID чата администратора (для уведомлений о заказах)
TELEGRAM_ADMIN_CHAT_ID=

# Ключ Google Gemini для Edge Function admin-ai
GEMINI_API_KEY=

# Общий секрет для анонимного AI-чата (клиент шлёт в x-shop-key)
CHAT_SHARED_SECRET=

# Telegram ID администраторов через запятую
ADMIN_TELEGRAM_IDS=

# Ссылка на Web App для кнопки в боте
FRONTEND_URL=
