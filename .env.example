# Required environment variables
# Add your secret keys in the AI Studio Settings menu (Environment Variables section)
# NEVER commit actual secrets to this file.

# Ответы ассистента: OpenRouter первым, LiteRouter запасным. Оба —
# OpenAI-совместимые, ключи только на сервере (Vercel env / локальный .env).
OPENROUTER_API_KEY=
LITEROUTER_API_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Браузер читает адрес и anon-ключ с префиксом VITE_ (или без него). Без этих
# переменных используется боевой адрес из src/lib/supabase.ts. Сервисный ключ
# с префиксом VITE_ не добавлять никогда: он попадёт в сборку.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Отправка заказа мастеру через бота. Токен берётся у @BotFather, id чата — у
# @userinfobot. Мастер должен хоть раз написать боту, иначе Telegram не даст
# ему написать первым. Обе переменные — только на сервере: на Vercel это
# переменные проекта, в репозиторий и в сборку браузера они не попадают.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
ADMIN_TELEGRAM_IDS=123456789
PAYMENT_CARD_NUMBER=
PAYMENT_CARD_RECIPIENT=
PAYMENT_CRYPTO_ADDRESS=
PAYMENT_CRYPTO_NETWORK=
